{
  "name": "datocms-plugin-frontify-asset-source",
  "version": "0.3.5",
  "private": false,
  "description": "Insert photos from your Frontify Account directly inside of your DatoCMS project",
  "keywords": [
    "datocms-plugin",
    "frontify"
  ],
  "homepage": "https://github.com/gempi/datocms-plugin-frontify-asset-source#readme",
  "author": "Matthias Wolgensinger <hello@m18r.io>",
  "repository": {
    "url": "https://github.com/gempi/datocms-plugin-frontify-asset-source"
  },
  "files": [
    "dist",
    "docs"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint  --fix",
    "prepare": "simple-git-hooks",
    "fmt": "oxfmt",
    "typecheck": "tsc --noEmit",
    "release": "pnpm build && changeset publish"
  },
  "dependencies": {
    "@frontify/frontify-authenticator": "^2.1.0",
    "@stylexjs/stylex": "^0.19.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@types/node": "^24.19.2",
    "datocms-plugin-sdk": "^2.5.0",
    "datocms-react-ui": "^2.5.1",
    "gql.tada": "^1.11.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "urql": "^5.0.4"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "baseline-browser-mapping": "^2.11.28",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.87.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint && npm run fmt"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.15.0",
  "datoCmsPlugin": {
    "title": "Asset source for Frontify",
    "previewImage": "docs/preview.mp4",
    "coverImage": "docs/cover.png",
    "entryPoint": "dist/index.html",
    "permissions": []
  }
}
